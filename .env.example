# Local development only. In production set these in the
# Cloudflare Pages dashboard under Settings -> Environment variables.

SITE_URL=https://example.com

# Snipcart PUBLIC key (test key while building)
SNIPCART_PUBLIC_KEY=

# Snipcart SECRET key. Never commit this. Used by:
#  - functions/api/shipping.js  (webhook verification)
#  - src/_data/stock.js         (optional build-time stock sync)
SNIPCART_SECRET_KEY=
