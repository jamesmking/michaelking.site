# Local development only. In production set these in the
# Cloudflare Pages dashboard under Settings -> Environment variables.

SITE_URL=https://example.com

# --- Enquiry form (functions/api/enquiry.js) --------------------------------
# Without RESEND_API_KEY the form fails visibly and tells the customer to
# email instead, rather than silently dropping the enquiry.

# From resend.com. The free tier covers this volume many times over.
RESEND_API_KEY=

# A verified sender on the domain, e.g.
#   Michael King Prints <shop@michaelking.site>
ENQUIRY_FROM=

# Where enquiries land. Defaults to ENQUIRY_FROM if unset.
ENQUIRY_TO=
