{
  "name": "michael-king-prints",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Catalogue of framed prints — film, music, theatre, book covers, pop art. 11ty on Cloudflare Pages. Enquiry-based, no online checkout.",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "clean": "rm -rf _site",
    "import:catalogue": "node scripts/import-catalogue.mjs",
    "import:images": "node scripts/import-images.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
