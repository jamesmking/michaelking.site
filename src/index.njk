---
layout: layouts/base.njk
title: false
description: Framed prints of film posters, gig posters, book covers and pop art — made one at a time in Coventry.
---

<section class="hero">
  <h1 class="hero__title">
    Framed prints of the
    <span class="hero__ink" data-ink="magenta">records</span>,
    <span class="hero__ink" data-ink="cyan">films</span> and
    <span class="hero__ink" data-ink="key">books</span>
    worth putting on a wall.
  </h1>
  <p class="hero__body">{{ site.tagline }}</p>
  <p class="hero__actions">
    <a class="btn btn--accent" href="/prints/">See all {{ prints | length }} prints</a>
  </p>
</section>

<section class="sections">
  <h2 class="visually-hidden">Browse by section</h2>
  <ul class="sections__list">
    {% for category in categories %}
      <li class="sections__item" data-ink="{{ category.ink }}">
        <a href="/{{ category.slug }}/">
          <span class="sections__title">{{ category.title }}</span>
          <span class="sections__count">{{ prints | byCategory(category.slug) | length }} prints</span>
        </a>
        <p class="sections__desc">{{ category.description }}</p>
      </li>
    {% endfor %}
  </ul>
</section>

<section class="strip">
  <h2 class="strip__head">A few of them</h2>
  <div class="grid">
    {% for print in prints | hasImage | spread(8) %}{% include "partials/card.njk" %}{% endfor %}
  </div>
  <p class="strip__more"><a href="/prints/">See the full catalogue →</a></p>
</section>
