---
layout: layouts/base.njk
pagination:
  data: prints
  size: 1
  alias: print
permalink: "/prints/{{ print.slug }}/"
eleventyComputed:
  title: "{{ print.title }}"
  description: "{{ print.blurb }}"
  ink: "{{ print.theme }}"
---
{% from "partials/print-card.njk" import qty, dots %}
{% set left = qty(print, stock) | trim | int %}

<article class="print">
  <div class="print__image">
    <img src="{{ print.image }}" alt="{{ print.alt }}" width="1000" height="1414">
  </div>

  <div class="print__detail">
    <p class="print__eyebrow">{{ print.theme }} · {{ print.year }}</p>
    <h1 class="print__title">{{ print.title }}</h1>
    <p class="print__blurb">{{ print.blurb }}</p>

    <dl class="spec">
      <div class="spec__row"><dt>Technique</dt><dd>{{ print.technique }}</dd></div>
      <div class="spec__row"><dt>Paper</dt><dd>{{ print.paper }}</dd></div>
      <div class="spec__row"><dt>Sizes</dt><dd>{% for s in print.sizes %}{{ s.label }}{% if not loop.last %}, {% endif %}{% endfor %}</dd></div>
    </dl>

    <p class="print__price">{{ print.price | money }}<span class="print__from">{% if print.sizes | length > 1 %} for A3, larger sizes priced at checkout{% endif %}</span></p>

    {{ dots(left) }}

    {% if left > 0 %}
      <button
        type="button"
        class="btn btn--buy snipcart-add-item"
        data-item-id="{{ print.id }}"
        data-item-name="{{ print.title }}"
        data-item-price="{{ print.price | price }}"
        data-item-url="{{ page.url }}"
        data-item-image="{{ print.image }}"
        data-item-description="{{ print.technique }} on {{ print.paper }}"
        data-item-max-quantity="{{ left }}"
        data-item-custom1-name="Size"
        data-item-custom1-options="{{ print.sizes | sizeOptions }}"
        data-item-custom2-name="Anything you'd like written on the back?"
        data-item-custom2-type="textarea"
        data-item-custom2-required="false">
        Add to basket
      </button>
    {% else %}
      <p class="soldout">This one has gone. Email <a href="mailto:{{ site.email }}?subject=Reprint%20of%20{{ print.title | urlencode }}">{{ site.email }}</a> and you'll be told first if it's ever pulled again.</p>
    {% endif %}

    <p class="print__delivery">
      Free delivery or collection on postcodes {{ site.localPostcodes | join(", ") }}.
      Elsewhere in the UK, {{ site.shipping.standard | money }} tracked.
    </p>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ print.title | dump | safe }},
  "image": {{ (print.image | absolute(site.url)) | dump | safe }},
  "description": {{ print.blurb | dump | safe }},
  "brand": { "@type": "Brand", "name": {{ site.name | dump | safe }} },
  "offers": {
    "@type": "Offer",
    "url": {{ (page.url | absolute(site.url)) | dump | safe }},
    "priceCurrency": "GBP",
    "price": "{{ print.price | price }}",
    "availability": "https://schema.org/{% if left > 0 %}InStock{% else %}OutOfStock{% endif %}"
  }
}
</script>
