---
layout: layouts/base.njk
pagination:
  data: prints
  size: 1
  alias: print
permalink: "/prints/{{ print.slug }}/"
eleventyComputed:
  title: "{{ print.title }}"
  description: "{{ print.note or print.title }}"
  ink: "{{ (categories | find('slug', print.category)).ink }}"
---
{% set category = categories | find("slug", print.category) %}
{% set sub = category.subs | find("slug", print.sub) %}

<article class="print" data-shape="{{ print.shape }}">
  <div class="print__images">
    {% for image in pictures[print.slug].detail %}
      {{ image | safe }}
    {% else %}
      <p class="print__pending">A photograph of this one is still to come. Ask and it'll be sent over.</p>
    {% endfor %}
  </div>

  <div class="print__detail">
    <p class="print__eyebrow">
      <a href="/{{ category.slug }}/">{{ category.title }}</a>{% if sub %} · {{ sub.title }}{% endif %}
    </p>
    <h1 class="print__title">{{ print.title }}</h1>
    {% if print.note %}<p class="print__blurb">{{ print.note }}</p>{% endif %}

    <table class="options">
      <caption class="visually-hidden">Sizes, frames and prices</caption>
      <thead>
        <tr><th scope="col">Size</th><th scope="col">Frame</th><th scope="col">Price</th></tr>
      </thead>
      <tbody>
        {% for option in print.options %}
          <tr>
            <td>{{ option.size }}</td>
            <td>{{ option.frame }}</td>
            <td class="options__price">{{ option.price | money }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <form class="reserve" method="post" action="/api/enquiry">
      <h2 class="reserve__head">Reserve this print</h2>
      <p class="reserve__intro">
        Send the details and Michael will confirm it's available and arrange
        {% if site.payment | length %}payment — {{ site.payment | join(", ") | lower }}{% else %}payment{% endif %}.
        Nothing is charged here.
      </p>

      <input type="hidden" name="print" value="{{ print.title }}">
      <input type="hidden" name="printUrl" value="{{ page.url | absolute(site.url) }}">
      {# Bots fill this in; people never see it. #}
      <p class="reserve__trap" aria-hidden="true">
        <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
      </p>

      {% if print.options | length > 1 %}
        <p class="field">
          <label for="option">Which one</label>
          <select id="option" name="option">
            {% for option in print.options %}
              <option value="{{ option.size }}, {{ option.frame }}">{{ option.size }} · {{ option.frame }} · {{ option.price | money }}</option>
            {% endfor %}
          </select>
        </p>
      {% else %}
        <input type="hidden" name="option" value="{{ print.options[0].size }}, {{ print.options[0].frame }}">
      {% endif %}

      <p class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" autocomplete="name" required>
      </p>
      <p class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
      </p>
      <p class="field">
        <label for="phone">Phone <span class="field__opt">optional</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel">
      </p>

      <fieldset class="field field--choice">
        <legend>Collection or delivery</legend>
        <label><input type="radio" name="fulfilment" value="Collection" checked> Collection</label>
        <label><input type="radio" name="fulfilment" value="Delivery"> Delivery</label>
      </fieldset>

      <p class="field">
        <label for="message">Anything else <span class="field__opt">optional</span></label>
        <textarea id="message" name="message" rows="3"></textarea>
      </p>

      <button type="submit" class="btn btn--accent">Send enquiry</button>

      <p class="reserve__alt">
        Or email <a href="mailto:{{ site.email }}?subject={{ print.title | urlencode }}">{{ site.email }}</a> directly.
      </p>
    </form>

    <p class="print__delivery">
      Collection or delivery in {{ site.localArea }}. {{ site.deliveryNote }}
    </p>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ print.title | dump | safe }},
  {% if print.images | length %}"image": {{ (print.images[0].src | absolute(site.url)) | dump | safe }},{% endif %}
  "description": {{ (print.note or print.title) | dump | safe }},
  "brand": { "@type": "Brand", "name": {{ site.name | dump | safe }} }
  {%- if print.priceFrom %},
  "offers": {
    "@type": "Offer",
    "url": {{ (page.url | absolute(site.url)) | dump | safe }},
    "priceCurrency": "GBP",
    "price": "{{ print.priceFrom }}",
    "availability": "https://schema.org/InStock"
  }
  {%- endif %}
}
</script>
