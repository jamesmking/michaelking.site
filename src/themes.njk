---
layout: layouts/base.njk
pagination:
  data: themes
  size: 1
  alias: theme
permalink: "/{{ theme.slug }}/"
eleventyComputed:
  title: "{{ theme.title }}"
  description: "{{ theme.description }}"
  ink: "{{ theme.slug }}"
---
{% from "partials/print-card.njk" import card %}

<header class="page-head">
  <h1 class="page-head__title">{{ theme.title }}</h1>
  <p class="page-head__body">{{ theme.description }}</p>
</header>

<div class="grid">
  {% for print in prints | byTheme(theme.slug) %}
    {{ card(print, stock) }}
  {% else %}
    <p class="empty">Nothing here yet. New designs go up most months.</p>
  {% endfor %}
</div>
