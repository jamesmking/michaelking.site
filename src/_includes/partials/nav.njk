<header class="masthead">
  <a class="wordmark" href="/">
    <span class="wordmark__a">{{ site.wordmark[0] }}</span><span class="wordmark__b">{{ site.wordmark[1] }}</span><span class="wordmark__c">{{ site.wordmark[2] }}</span>
  </a>

  <nav class="nav" aria-label="Main">
    <a href="/prints/" {% if page.url == "/prints/" %}aria-current="page"{% endif %}>All prints</a>
    {% for category in categories %}
      <a href="/{{ category.slug }}/"
         class="nav__ink"
         data-ink="{{ category.ink }}"
         {% if page.url == "/" + category.slug + "/" %}aria-current="page"{% endif %}>{{ category.title }}</a>
    {% endfor %}
    <a href="/about/" {% if page.url == "/about/" %}aria-current="page"{% endif %}>About</a>
  </nav>
</header>
